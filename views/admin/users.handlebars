<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <title>Manage Users</title>

    <style>
        body {
            background: #f5f6fa;
        }

        .sidebar {
            min-height: 100vh;
            background: #212529;
            color: white;
        }

        .sidebar .nav-link {
            color: #adb5bd;
            padding: 12px 15px;
            border-radius: 6px;
            margin-bottom: 5px;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: #343a40;
            color: white;
        }

        .sidebar .nav-link i {
            margin-right: 10px;
        }

        .main-content {
            padding: 30px;
        }

        .logout-btn {
            width: 100%;
            text-align: left;
        }

        @media(max-width: 767px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                padding: 20px 12px;
            }
        }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <aside class="col-md-3 col-lg-2 sidebar p-3">

                <h4 class="text-warning mb-4">
                    Member Page
                </h4>

                <ul class="nav flex-column">

                    <li class="nav-item">
                        <a href="/member" class="nav-link">
                            <i class="bi bi-speedometer2"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="bi bi-box-seam"></i>
                            Purchase Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link active">
                            <i class="bi bi-people"></i>
                            Settings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="#" class="nav-link">
                            <i class="bi bi-cart"></i>
                            My Orders
                        </a>
                    </li>

                    {{!-- <li class="nav-item">
                        <a href="/admin/categories" class="nav-link">
                            <i class="bi bi-tags"></i>
                            Categories
                        </a>
                    </li> --}}

                </ul>

                <hr class="border-secondary">

                <!-- Logout -->
                {{!-- <form action="/auth/logout" method="POST">
                    <button type="submit" class="btn btn-danger logout-btn">
                        <i class="bi bi-box-arrow-right me-2"></i>
                        Logout
                    </button>
                </form> --}}
                <a href="/auth/logout" class="btn btn-danger logout-btn">
                Logout
                </a>


            </aside>


            <!-- Main Content -->
            <main class="col-md-9 col-lg-10 main-content">

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div>
                        <h2>Manage Orders</h2>
                        <p class="text-muted">
                            View and manage Orders.
                        </p>
                    </div>

                </div>


                <!-- Users Table -->
                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Registered Users</h5>
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Product Name</th>
                                        <th>Email</th>
                                        <th>Customer Name</th>
                                        <th>Quantity</th>
                                        <th>Price</th>
                                    </tr>
                                </thead>

                                {{!-- <tbody>
                                    {{#each users}}
                                    <tr>
                                        <td>{{this.id}}</td>
                                        <td>{{this.name}}</td>
                                        <td>{{this.email}}</td>

                                        <td>
                                            <span
                                                class="badge {{#if (eq this.role 'admin')}}bg-danger{{else}}bg-primary{{/if}}">
                                                {{this.role}}
                                            </span>
                                        </td>

                                        <td>
                                            <a href="/admin/users/edit/{{this.id}}" class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                                Edit
                                            </a>
                                        </td>
                                    </tr>
                                    {{else}}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">
                                            No registered users found.
                                        </td>
                                    </tr>
                                    {{/each}}
                                </tbody> --}}

                            </table>

                        </div>

                    </div>
                </div>

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>